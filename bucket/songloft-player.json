{
    "version": "2.13.8",
    "description": "Songloft Player - A cross-platform music player",
    "homepage": "https://github.com/songloft-org/songloft-player",
    "license": "Apache-2.0",
    "conflicts": "songloft-bundled",
    "architecture": {
        "64bit": {
            "url": "https://github.com/songloft-org/songloft-player/releases/download/v2.13.8/songloft-windows-x64.zip",
            "hash": "f361cae8b5e16cb0c50a7a9ed3786a3713459e2e2f56c983668b80ddd9696a37"
        }
    },
    "shortcuts": [
        [
            "songloft_flutter.exe",
            "Songloft Player"
        ]
    ],
    "post_uninstall": [
        "if ($purge) {",
        "    Remove-Item \"$env:APPDATA\\com.songloft\" -Recurse -Force -ErrorAction SilentlyContinue",
        "}"
    ],
    "checkver": {
        "script": [
            "$response = Invoke-RestMethod 'https://api.github.com/repos/songloft-org/songloft-player/releases/latest'",
            "$response.tag_name"
        ],
        "regex": "v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/songloft-org/songloft-player/releases/download/v$version/songloft-windows-x64.zip"
            }
        }
    }
}
